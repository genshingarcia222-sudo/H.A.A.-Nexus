# Tauri build output. `gen/schemas` is regenerated by tauri-build on every
# compile. Cargo.lock is deliberately NOT ignored - this is a binary crate,
# so the lockfile belongs in source control.
apps/desktop/src-tauri/gen/schemas/

# Secrets and provider credentials. Nothing matching these has ever been
# committed (verified during the Phase 7 security/privacy boundary audit);
# these patterns exist so that stays true once payment/AI/TTS providers are
# wired up in Phase 8 and later.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Per-checkout workstation identity for the distributed sync protocol
# (.nexus/DECISIONS.md N-004). It names which logical device (DEVICE-01 or
# DEVICE-02) this checkout is, so it is different on every machine and must
# never be committed. The tracked template is .nexus/local-device.example.yaml.
.nexus/local-device.yaml
